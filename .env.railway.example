APP_NAME=DentiFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dentiflow-production-ab21.up.railway.app

# Opcional en despliegues que ya tienen cuentas administrativas.
DENTIFLOW_SUPERADMIN_EMAIL=
DENTIFLOW_SUPERADMIN_PASSWORD=
DENTIFLOW_ADMIN_EMAIL=
DENTIFLOW_ADMIN_PASSWORD=

# Mantener APP_KEY sin cambios entre despliegues. Si cambia, todas las
# sesiones y datos cifrados dejan de ser validos.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=dentiflow_session

# Railway debe proporcionar las variables DB_* desde el servicio MySQL.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
MYSQL_SESSION_WAIT_TIMEOUT=600
MYSQL_SESSION_INTERACTIVE_TIMEOUT=600
